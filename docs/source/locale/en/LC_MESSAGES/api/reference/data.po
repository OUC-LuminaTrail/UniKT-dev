#: 897ce0c74bae4872bf2525b03a109cf2 of
#: utils.model_data.base_model_data.BaseModelData.calculate_question_difficulty:1
msgid "Calculate difficulty metrics for each question."
msgstr "Calculate difficulty metrics for each question."

#: 41a9bd9a37f74de3aee42f389f22f4cd of
#: utils.model_data.base_model_data.BaseModelData.calculate_question_difficulty:3
msgid ""
"Difficulty is computed from: 1. Correct rate (correct_rate): correct "
"answers / total answers 2. Average response time (avg_time): if the "
"dataset has a time field 3. Hint rate (hint_rate): if the dataset has a "
"hint field"
msgstr ""
"Difficulty is computed from: 1. Correct rate (correct_rate): correct "
"answers / total answers 2. Average response time (avg_time): if the "
"dataset has a time field 3. Hint rate (hint_rate): if the dataset has a "
"hint field"

#: 2063d3f5a1c64a299fef972eb7f2cc76 of
#: utils.model_data.base_model_data.BaseModelData.calculate_question_difficulty:8
msgid ""
"Fold index to exclude (used during cross-validation to avoid data leakage"
" from the validation fold)."
msgstr ""
"Fold index to exclude (used during cross-validation to avoid data leakage"
" from the validation fold)."

#: a23164d05b5e43dcae4d7f4fbc52654f of
#: utils.model_data.base_model_data.BaseModelData.calculate_question_difficulty:11
msgid "Question ID to difficulty score mapping (0-1, higher = harder)."
msgstr "Question ID to difficulty score mapping (0-1, higher = harder)."

#: ddffca4581004ac59ccd42e227687e16 of
#: utils.model_data.base_model_data.BaseModelData.calculate_question_difficulty:14
msgid "Formula:"
msgstr "Formula:"

#: c80896c7a1fd4b3980f82a5e80fd50ae of
#: utils.model_data.base_model_data.BaseModelData.calculate_question_difficulty:15
msgid ""
"difficulty = (1 - correct_rate) * 0.6 + normalized_time * 0.3 + hint_rate"
" * 0.1"
msgstr ""
"difficulty = (1 - correct_rate) * 0.6 + normalized_time * 0.3 + hint_rate"
" * 0.1"

