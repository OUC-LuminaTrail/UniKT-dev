# Copy this file to .env and fill in your values.

# Lark (Feishu) webhook
LARK_WEBHOOK_URL=
LARK_SECRET=

# SwanLab experiment tracking
SWANLAB_MODE=cloud
KT_SWANLAB_WORKSPACE=
KT_SWANLAB_PROJECT=

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Async metric logging (1 = background thread, 0 = synchronous)
METRIC_LOGGING_ASYNC=1

# Web frontend dev/preview server port
KT_WEB_PORT=5173
