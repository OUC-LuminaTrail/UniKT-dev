# Lark (Feishu) Webhook Configuration
# Replace with your actual webhook URL and secret
LARK_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LARK_SECRET=xxxxxxxxxxxxxxxxxxxxxx

# SwanLab Configuration
SWANLAB_WORKSPACE=your_workspace_name_here
SWANLAB_MODE=cloud

# Logging Configuration
# Controls the logging verbosity level for the unified logging system
# Options: DEBUG, INFO (default), WARNING, ERROR
# Example:
#   LOG_LEVEL=DEBUG    # Show all log messages (useful for debugging)
#   LOG_LEVEL=INFO     # Show general information (recommended for normal use)
#   LOG_LEVEL=WARNING  # Show only warnings and errors
#   LOG_LEVEL=ERROR    # Show only errors
LOG_LEVEL=INFO

# Async Metric Logging
# Offloads metric logging (SwanLab network uploads, per-batch CSV flushes) to a
# background thread so logging I/O never blocks the GPU training loop.
# Enabled by default; set to 0/false/no (case-insensitive) or empty to fall
# back to synchronous, blocking logging.
# Example:
#   METRIC_LOGGING_ASYNC=1   # Enable (default): background-thread logging
#   METRIC_LOGGING_ASYNC=0   # Disable: synchronous logging on the main thread
METRIC_LOGGING_ASYNC=1

# Web Frontend Configuration
# Port for the Vite dev/preview server (web-dev / web-serve)
# Default: 5173
# Example:
#   KT_WEB_PORT=8080    # Run frontend on port 8080
# KT_WEB_PORT=5173
