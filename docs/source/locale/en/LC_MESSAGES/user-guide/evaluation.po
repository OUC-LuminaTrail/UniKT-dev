#: ../../source/user-guide/evaluation.md:30 7eb5b0e4b37c40ad979eda8953439fb1
msgid "用途"
msgstr "Usage"

#: ../../source/user-guide/evaluation.md:30 2247206b745a4d9baf2270347a3ce804
