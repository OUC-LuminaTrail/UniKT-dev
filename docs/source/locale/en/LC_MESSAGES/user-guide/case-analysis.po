msgstr "select — Student selection"

#: ../../source/user-guide/case-analysis.md:72 8fd372d55ee245e1aeea1664c3e3496a
msgid "从推理结果中按策略筛选目标学生。"
msgstr "Selects target students from the inference results according to a strategy."

#: ../../source/user-guide/case-analysis.md:62 2612804dc35143509e67713941a03092
#: 29a24bd99e214daaa83a7de8a7f06590
