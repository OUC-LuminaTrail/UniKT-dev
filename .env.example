# Lark (Feishu) Webhook Configuration
# Replace with your actual webhook URL and secret
LARK_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LARK_SECRET=xxxxxxxxxxxxxxxxxxxxxx

# SwanLab Configuration
SWANLAB_WORKSPACE=your_workspace_name_here
SWANLAB_MODE=cloud

# Logging Configuration
# Controls the logging verbosity level for the unified logging system
# Options: DEBUG, INFO (default), WARNING, ERROR
# Example:
#   LOG_LEVEL=DEBUG    # Show all log messages (useful for debugging)
#   LOG_LEVEL=INFO     # Show general information (recommended for normal use)
#   LOG_LEVEL=WARNING  # Show only warnings and errors
#   LOG_LEVEL=ERROR    # Show only errors
LOG_LEVEL=INFO
