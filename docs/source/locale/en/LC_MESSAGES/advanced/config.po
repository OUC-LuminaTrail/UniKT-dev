msgid "``SWANLAB_WORKSPACE``"
msgstr "``SWANLAB_WORKSPACE``"

#: ../../source/advanced/config.md 5a1abbda14e24f3d91982b91a31a12d6
msgid "SwanLab 工作空间名称，不设置则使用默认空间"
msgstr "SwanLab workspace name; if unset, the default workspace is used"

#: ../../source/advanced/config.md 16a01e48319f44e88ecd22bf8b03085b
msgid "``SWANLAB_MODE``"
msgstr "``SWANLAB_MODE``"

#: ../../source/advanced/config.md 982658af66e041a996191f3dfd49444f
msgid "``cloud``（上传到云端）或 ``local``（仅本地记录，默认）"
msgstr "``cloud`` (upload to the cloud) or ``local`` (local-only logging, default)"

#: ../../source/advanced/config.md cfb363d1e4674f29a7bb6e9ee5d042c2
