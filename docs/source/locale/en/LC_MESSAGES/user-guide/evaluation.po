#: ../../source/user-guide/evaluation.md:30 9114cbbea8fb4f1f936538b7c403b8f4
msgid "acc/auc/rmse 的真实值"
msgstr "Ground-truth values for acc/auc/rmse"

#: ../../source/user-guide/evaluation.md:30 b5aa852d14e84cf5a7dc55f09acecc25
msgid "``y_predict``"
msgstr "``y_predict``"

#: ../../source/user-guide/evaluation.md:30 2146174c2ab544b7b97f4cd952f58475
