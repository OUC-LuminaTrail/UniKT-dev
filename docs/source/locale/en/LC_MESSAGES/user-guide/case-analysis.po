msgstr "Minimum number of responses per student"

#: ../../source/user-guide/case-analysis.md:62 6d0664a097f944bf9c22b41df40447a8
msgid "``--min_error``"
msgstr "``--min_error``"

#: ../../source/user-guide/case-analysis.md:62 26ebed9d52f048a89d1df82c9a8b9870
msgid "``0.1``"
msgstr "``0.1``"

#: ../../source/user-guide/case-analysis.md:62 cd31f9cc4a6c4619bacc43d3c025f69e
msgid "最低错误率"
msgstr "Minimum error rate"

#: ../../source/user-guide/case-analysis.md:62 53431dc30fbc4ba496f3d465ec51c62e
msgid "``--max_error``"
msgstr "``--max_error``"

#: ../../source/user-guide/case-analysis.md:62 4af9a8d7d00449658d4640f08773da8f
