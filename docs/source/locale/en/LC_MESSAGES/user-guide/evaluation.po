msgstr "Binary predictions"

#: ../../source/user-guide/evaluation.md:30 6ae7944760ce4e26ae75d7896ae0a946
msgid "acc 的预测值"
msgstr "Predicted values for acc"

#: ../../source/user-guide/evaluation.md:30 bff08dc8adca475ca89e7e4d4718258b
msgid "``y_score``"
msgstr "``y_score``"

#: ../../source/user-guide/evaluation.md:30 a26e8979c23c4544af0b34fb135e0313
msgid "排序分数"
msgstr "Ranking scores"

#: ../../source/user-guide/evaluation.md:30 300fa6efc1de4207888ea204e1474123
msgid "auc 的输入分数"
