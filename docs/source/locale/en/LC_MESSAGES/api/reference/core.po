#: 0448d21e879f4aaf9b0cce707092a1a8 of utils.core.logger:1
msgid "Unified logging module for the KT experiment framework."
msgstr "Unified logging module for the KT experiment framework."

#: 824b24ceb2674184b174b1afaed3f3e8 of utils.core.logger:3
msgid ""
"This module provides a consistent logging interface for all framework "
"components. The log level is controlled by the ``LOG_LEVEL`` environment "
"variable (default: INFO)."
msgstr ""
"This module provides a consistent logging interface for all framework "
"components. The log level is controlled by the ``LOG_LEVEL`` environment "
"variable (default: INFO)."

#: 86c29030bb0d47359f7642f7a6ded561 of utils.core.logger:7
msgid "Usage:"
msgstr "Usage:"

#: 4138aafb1479449ab3a795d5e9df97a0 of utils.core.logger:8
msgid "from utils.core import get_logger"
msgstr "from utils.core import get_logger"

#: d0f5679768b6426e80cb0776c4e5dde3 of utils.core.logger:10
msgid ""
"logger = get_logger(__name__) logger.info(\"Training started\") "
"logger.warning(\"Missing data, using defaults\") logger.error(\"Model "
"loading failed\")"
msgstr ""
"logger = get_logger(__name__) logger.info(\"Training started\") "
"logger.warning(\"Missing data, using defaults\") logger.error(\"Model "
"loading failed\")"

#: fd23f2dbbe9c4f839f8db8e9d2e6ac39 of utils.core.logger:15
msgid "Environment Variables:"
msgstr "Environment Variables:"

#: 8747c186a7bf444293fad9c22fc805e4 of utils.core.logger:16
msgid "LOG_LEVEL: Controls logging verbosity (DEBUG, INFO, WARNING, ERROR)."
msgstr "LOG_LEVEL: Controls logging verbosity (DEBUG, INFO, WARNING, ERROR)."

#: 6ed2804cd758449fbbb9f544c7207f1c of utils.core.logger:17
msgid "Default: INFO"
msgstr "Default: INFO"

#: c972474252504dd69a255bae1f5b82c3 of utils.core.logger:19
msgid "Log Format:"
msgstr "Log Format:"

#: a6d0c8fbbf9e4c80bc4cfbf2c96bec1c of utils.core.logger:20
msgid "[HH:MM:SS][LEVEL][module_name] message"
msgstr "[HH:MM:SS][LEVEL][module_name] message"

#: 2b1507586b7046bb84a7e196d416b9ce of utils.core.logger.get_logger:1
msgid "Get a logger instance with a unified configuration."
msgstr "Get a logger instance with a unified configuration."

#: 1dfbe37d11014f998fb22167aaaecc37 of utils.core.logger.get_logger:3
msgid ""
"The returned logger is configured with: - A level from the ``LOG_LEVEL`` "
"environment variable (default: INFO). - Console-only output (SwanLab "
"handles file logging for training metrics). - A uniform format: "
"``[HH:MM:SS][LEVEL][module_name] message``."
msgstr ""
"The returned logger is configured with: - A level from the ``LOG_LEVEL`` "
"environment variable (default: INFO). - Console-only output (SwanLab "
"handles file logging for training metrics). - A uniform format: "
"``[HH:MM:SS][LEVEL][module_name] message``."

#: 65014539bc0a441da7786cac9da45714 of utils.core.logger.get_logger:8
msgid "Logger name, typically ``__name__`` for module-level logging."
msgstr "Logger name, typically ``__name__`` for module-level logging."

